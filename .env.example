# ┌─────────────────────────────┐
# |         Base de datos       |
# └─────────────────────────────┘
DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_SCHEMA=geren2
DB_SSLMODE=require
DB_CONNECT_TIMEOUT=10

# ┌─────────────────────────────┐
# |         Google API Key      |
# └─────────────────────────────┘
# Obtener en https://aistudio.google.com/apikey
GOOGLE_API_KEY=
GOOGLE_GENAI_USE_VERTEXAI=FALSE
MODEL_NAME=gemini-3.5-flash-lite

# ┌─────────────────────────────┐
# |         MCP Server          |
# └─────────────────────────────┘
# El agente ADK levanta el MCPServer por stdio; los valores HTTP solo aplican
# si se ejecuta el servidor de forma independiente con MCP_TRANSPORT.
MCP_TRANSPORT=stdio
MCP_SERVER_HOST=127.0.0.1
MCP_SERVER_PORT=8000

# ┌─────────────────────────────┐
# |     Agente conversacional   |
# └─────────────────────────────┘
# Intérprete del entorno .venv que ejecuta el MCPServer. Solo es necesario
# si la ruta autodetectada no es la correcta.
# Linux / Mac: .venv/bin/python
# Windows:     .venv\Scripts\python.exe
MCP_PYTHON=
